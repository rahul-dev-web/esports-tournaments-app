# ===== ENVIRONMENT =====
ENVIRONMENT=development
DEBUG=true

# ===== BACKEND =====
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ===== DATABASE =====
# Local development only. Production uses Supabase PostgreSQL.
DATABASE_URL=sqlite:///./arenahub.db

# ===== SUPABASE =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_JWT_SECRET=replace-me

# ===== AUTH / ADMIN =====
ADMIN_EMAILS=admin@example.com

# ===== FIREBASE =====
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=replace-me

# ===== ADMOB =====
ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxx~xxxxxxxx
ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxx~xxxxxxxx
ADMOB_ANDROID_REWARDED_AD_UNIT_ID=ca-app-pub-xxxxxxxx/xxxxxxxx
ADMOB_IOS_REWARDED_AD_UNIT_ID=ca-app-pub-xxxxxxxx/xxxxxxxx
ADMOB_SSV_PUBLIC_KEYS_URL=https://www.gstatic.com/admob/reward/verifier-keys.json
ADMOB_SSV_SECRET=replace-me
